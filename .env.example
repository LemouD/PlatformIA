# Copy to .env (never committed) and fill in. No secret belongs in this example file.

# Port the server listens on, always on 127.0.0.1 (npm run start). Default: 3000.
# PORT=3000

# Names other devices use to reach AI OS through `tailscale serve`, comma separated.
# Requests with any other Host header are refused, and these names are only accepted over HTTPS.
# AI_OS_EXTRA_HOSTS=my-pc.my-tailnet.ts.net
